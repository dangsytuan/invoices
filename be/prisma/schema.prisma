datasource db {
  provider = "postgresql" // Hoặc mysql, sqlserver tùy bạn chọn
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enum phân loại Chiều giao dịch (Mua vào / Bán ra)
enum InvoiceType {
  INBOUND  // Hóa đơn mua vào (Công ty mình là người mua)
  OUTBOUND // Hóa đơn bán ra (Công ty mình là người xuất bán)
}

// Bảng lưu thông tin chung của Hóa đơn
model Invoice {
  id           String            @id @default(uuid())
  type         InvoiceType  // Phân loại: INBOUND (Mua vào) hoặc OUTBOUND (Bán ra)
  
  // Thông tin định danh hóa đơn
  nbmst        String            // Mã số thuế người bán
  nbten        String            // Tên người bán
  nmmst        String            // Mã số thuế người mua
  nmten        String            // Tên người mua
  
  khmshdon     Int               // Ký hiệu mẫu số hóa đơn (VD: 1)
  khhdon       String            // Ký hiệu hóa đơn (VD: C26TVN)
  shdon        Int               // Số hóa đơn (VD: 170)
  hdon         String            // Loại hóa đơn (VD: "01" - Hóa đơn GTGT)
  thdon        String            // Tên loại hóa đơn (VD: "Hóa đơn giá trị gia tăng")

  tthai        Int               @default(1)
  
  cqt          String?           // Cơ quan thuế cấp mã
  hsgcma       String?           // Mã cơ quan thuế / Mã giao dịch CQT
  mhdon        String?           // Mã hóa đơn của cơ quan thuế
  ncma         DateTime?         // Ngày cấp mã
  nky          DateTime?         // Ngày ký số
  tdlap        DateTime          // Ngày lập hóa đơn
  
  // Thông tin thanh toán & Tiền tệ
  dvtte        String            @default("VND") // Đồng tiền thanh toán
  tgtcthue     Float             // Tổng giá trị chưa thuế
  tgtthue      Float             // Tổng tiền thuế GTGT
  tgtttbso     Float             // Tổng giá trị thanh toán bằng số (có thuế)
  tgtttbchu    String?           // Tổng giá trị thanh toán bằng chữ
  thtttoan     String?           // Hình thức thanh toán (VD: TM/CK)
  
  // Quan hệ 1-nhiều với chi tiết hóa đơn
  details      InvoiceDetail[]   
  stockTransactions StockTransaction[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([nbmst])
  @@index([nmmst])
  @@index([shdon, khhdon])
  @@index([tthai])
}

// Bảng lưu chi tiết hàng hóa, dịch vụ trong hóa đơn
model InvoiceDetail {
  id           String    @id @default(uuid())
  invoiceId    String    // Khóa ngoại liên kết tới bảng Invoice
  invoice      Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  stt          Int       // Số thứ tự dòng
  ten          String    // Tên hàng hóa, dịch vụ
  dvtinh       String?   // Đơn vị tính (VD: Chiếc, Bộ, Cái)
  sluong       Float     // Số lượng
  dgia         Float     // Đơn giá chưa thuế
  thtien       Float     // Thành tiền chưa thuế
  tsuat        Float     // Thuế suất (VD: 0.08 tương ứng 8%)
  ltsuat       String?   // Chuỗi thuế suất hiển thị (VD: "8%")
  stckhau      Float?    // Số tiền chiết khấu
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([invoiceId])
}

model StockTransaction {
  id              String        @id @default(uuid())
  invoiceId       String        // Khóa ngoại liên kết tới Invoice
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  // Liên kết tới sản phẩm chuẩn (Cho phép để trống nếu chưa map được)
  productId       String?       
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  type            InvoiceType   // INBOUND (Nhập) hoặc OUTBOUND (Xuất)
  productName     String        // Tên hàng gốc trên hóa đơn điện tử (để đối soát)
  unit            String?       // Đơn vị tính
  quantity        Float         // Số lượng
  unitPrice       Float         // Đơn giá chưa thuế
  totalAmount     Float         // Thành tiền chưa thuế
  transactionDate DateTime      // Ngày giao dịch (Lấy theo ngày lập hóa đơn tdlap)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([productId])
  @@index([productName])
  @@index([transactionDate])
  @@index([invoiceId])
}

model Product {
  id            String   @id @default(uuid())
  sku           String?   @unique // Mã SKU chuẩn nội bộ (Ví dụ: SP-AO-THUN-W-L)
  name          String   // Tên sản phẩm chuẩn đã chuẩn hóa trong hệ thống
  barcode       String?  @unique // Mã vạch chuẩn (nếu có trên sản phẩm)
  unit          String?   // Đơn vị tính chuẩn của kho (Ví dụ: Cái, Hộp, Kg)
  
  categoryId    String?  
  category      Category? @relation(fields: [categoryId], references: [id])

  // Quản lý tồn kho
  totalImported Float    @default(0) // Tổng lượng đã nhập
  totalExported Float    @default(0) // Tổng lượng đã xuất
  stockBalance  Float    @default(0) // Tồn kho hiện tại
  minStock      Float?   @default(0) // Định mức tồn kho tối thiểu (cảnh báo hết hàng)
  
  isActive      Boolean  @default(true) // Trạng thái sản phẩm (Đang kinh doanh / Ngừng kinh doanh)

  // Quan hệ với bảng quy tắc ánh xạ tên nhà cung cấp (Phục vụ tự động hóa HĐĐT)
  aliases       ProductAlias[]
  stockTransactions StockTransaction[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sku])
  @@index([name])
}

model ProductAlias {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name      String   // Tên khác của sản phẩm từ nhà cung cấp / hóa đơn

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name]) // Đảm bảo 1 sản phẩm chuẩn không bị lặp lại một tên alias y hệt
  @@index([name])             // Cực kỳ quan trọng để hệ thống tra cứu (lookup) tên cực nhanh
}

// Bảng danh mục sản phẩm (Phục vụ lọc, báo cáo)
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}